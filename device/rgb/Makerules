# This Makefile contains rules to build files in the device/rgb/ directory.

# Name of this component (the directory this file is stored in)
COMP = device/rgb

# Source files for this component
C_FILES = rgbClose.c rgbControl.c rgbInit.c rgbOpen.c rgbSet.c rgbWrite.c
S_FILES =

# Add the files to the compile source path
DIR = ${TOPDIR}/${COMP}
COMP_SRC += ${S_FILES:%=${DIR}/%} ${C_FILES:%=${DIR}/%}
