# This Makefile contains rules to build files in the device/sd/ directory.

# Name of this component (the directory this file is stored in)
COMP = device/sd

# Source files for this component
C_FILES = sdCard.c sdClose.c sdControl.c sdGetc.c sdHost.c sdInit.c \
          sdOpen.c sdPutc.c sdRead.c sdWrite.c
S_FILES =

# Add the files to the compile source path
DIR = ${TOPDIR}/${COMP}
COMP_SRC += ${S_FILES:%=${DIR}/%} ${C_FILES:%=${DIR}/%}
